# DAYMARK Environment Configuration (NaSCon '26)

# Optional: Google Gemini API Key (100% Free Tier)
# Get a free API key at: https://aistudio.google.com/app/apikey (Zero credit card needed)
# When set, powers Gemini 1.5 Flash executive takeaways & editorial lens analysis.
# If omitted, Daymark gracefully uses its built-in deterministic broadsheet synthesis engine.
GEMINI_API_KEY=

# MongoDB Connection URI (Atlas or Local)
# Example: mongodb+srv://username:password@cluster.mongodb.net/daymark?retryWrites=true&w=majority
# If omitted, Daymark gracefully falls back to local broadsheet storage with full zero-crash resilience.
MONGODB_URI=

# Optional: SMTP Email Server (for actual email OTP delivery)
# If omitted, verification codes are logged to the console & provided in API preview for seamless testing.
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM="DAYMARK Dispatch" <verify@daymark.news>

# Application Port
PORT=3000

# Environment Mode
NODE_ENV=production
